{
  "name": "cao",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run setup:dev && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "test": "concurrently -n dev,test -k -s command-test --hide dev 'bun run dev' 'turbo run test'",
    "test:watch": "concurrently 'bun run dev' 'turbo run test:watch'",
    "setup:dev": "bun install && bun run services:up && bun run services:check && bun run migrations:migrate",
    "migrations:migrate": "cd apps/server && bunx drizzle-kit migrate",
    "migrations:generate": "cd apps/server && bunx drizzle-kit generate",
    "services:check": "cd apps/server && bun run src/infra/scripts/wait-for-postgres.mjs",
    "services:up": "docker compose -f apps/server/docker-compose.yml up -d",
    "services:down": "docker compose -f apps/server/docker-compose.yml down"
  }
}
